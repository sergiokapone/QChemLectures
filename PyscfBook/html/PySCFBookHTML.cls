% ==============================================================================
%  PySCFBookHTML.cls -- HTML (lwarp) variant of PySCFBook.cls.
%  The print class is NOT touched, the chapters stay identical. Only what HTML needs:
%  lwarp first, then the maths / colours / tikz styles of the print class and simple
%  HTML blocks instead of its tcolorboxes. Code (minted) is styled by conspect.css and
%  gets the "copy" button from book.js.
% ==============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{PySCFBookHTML}[2026/11/23 lwarp variant of PySCFBook]
\LoadClass[onecolumn,twoside]{book}
\RequirePackage{iftex}
\RequirePackage{etoolbox}
% Parts of the print class (prepare_html.py cuts them out of PySCFBook.cls into _html/shared-*.tex)
\newcommand{\ConspectShared}[1]{\InputIfFileExists{_html/shared-#1.tex}{}{\ClassError{PySCFBookHTML}{_html/shared-#1.tex is missing}{Run python prepare_html.py first.}}}
% ---- lwarp must be loaded before other packages --------------------------------
\RequirePackage[HTMLFilename={ch},mathjax]{lwarp}
\boolfalse{FileSectionNames}
\setcounter{FileDepth}{0}        % one HTML page per chapter
\setcounter{tocdepth}{1}
\setcounter{secnumdepth}{2}
\HTMLLanguage{uk}
\makeatletter\AtBeginDocument{\def\LWR@printchaptername{}}\makeatother
\CSSFilename{conspect.css}

% ---- language and fonts (fonts matter only for images made by lateximage) ------
\RequirePackage{fontspec}
\IfFontExistsTF{CMU Serif}{\setmainfont{CMU Serif}}{\setmainfont{FreeSerif}}
\IfFontExistsTF{Roboto}{\setsansfont{Roboto}}{\setsansfont{FreeSans}}
% lwarp types HTML tags in the monospace font; the ligatures of JetBrains Mono (--> </ /> //) become a stray ^ in pdftotext
\IfFontExistsTF{JetBrains Mono}{\setmonofont{JetBrains Mono}[RawFeature={-calt,-liga}]}{\setmonofont{FreeMono}}
\defaultfontfeatures{Ligatures={TeX}}
\RequirePackage[english,russian,ukrainian]{babel}
\RequirePackage[unicode]{hyperref}   % lwarp patches it
\RequirePackage{csquotes}
\RequirePackage[dvipsnames,svgnames,table]{xcolor}
\newcommand{\Alexander}{\itshape}    % decorative font is print-only

% ---- colours of the book: taken from PySCFBook.cls (generated by prepare_html.py)
\ConspectShared{colors}

%===============================================================================
%  Math: same definitions as the print class (LaTeX / lateximage);
%  MathJax gets its own copy through lwarp-mathjax.tex (see \input at the end).
%===============================================================================
\RequirePackage[math-style=TeX,bold-style=TeX]{unicode-math}
\IfFontExistsTF{Stix Two Math}{\setmathfont{Stix Two Math}}{\setmathfont{Latin Modern Math}}
\RequirePackage{amsmath}
\RequirePackage{esint}
\RequirePackage{nicefrac}\let\nfrac\nicefrac
\RequirePackage{ifthen}
\def\EMF{\mathcal{E}}
\newcommand{\vect}[1]{\symbf{#1}}
\def\Efield{\vect{E}}\def\Dfield{\vect{D}}\def\Bfield{\vect{B}}\def\Hfield{\vect{H}}
\def\rot{\symbf{\nabla}\times}
\def\divg{\symbf{\nabla}\cdot}
\def\grad{\vect{\nabla}}
\def\diff#1#2{\frac{\partial #1}{\partial #2}}
\def\ddiff#1#2{\frac{\partial^2 #1}{\partial #2^2}}
\AtBeginDocument{%
	\let\phi\varphi
	\let\epsilon\varepsilon
	\DeclareMathOperator{\const}{const}
	\DeclareMathOperator{\Div}{div}
	\DeclareMathOperator{\Rot}{rot}
	\DeclareMathOperator{\Grad}{grad}
	\DeclareMathOperator{\inv}{inv}
	\newcommand{\Laplasian}{\Delta}
	\DeclareMathOperator{\Tr}{Tr}
}
\newcommand{\PySCF}{\texttt{PySCF}}
\def\ket#1{\left| #1 \right\rangle }
\def\bra#1{\left\langle #1 \right| }
\def\eff{e\kern-2.4pt{f\kern-2.65pt f}}
\def\vxi{\vec{\xi}}
\def\vr{\vec{r}}
\let\vphi\varphi
\let\veps\varepsilon
\ExplSyntaxOn
\NewDocumentCommand{\braket}{r<>}
  {
    \tl_set:Nn \l_tmpa_tl { #1 }
    \tl_replace_all:Nnn \l_tmpa_tl { | } { \middle | }
    \left\langle \l_tmpa_tl \right\rangle
  }
\NewDocumentCommand{\opbraket}{m m m}
  { \left\langle #1 \middle | #2 \middle  | #3 \right\rangle }
\ExplSyntaxOff
\NewDocumentCommand{\emphx}{m}{\emph{#1}}
\RequirePackage[version=4]{mhchem}
% siunitx is not loaded (lwarp patch fails): the only use is \si{\angstrom}
\newcommand{\angstrom}{\text{Å}}\newcommand{\si}[1]{#1}
\RequirePackage{array}
\RequirePackage{nicematrix}
% chemistry pictures (MOdiagram, chemfig, orbitals) are made by TikZ -> lateximage
\RequirePackage{modiagram}
% (chemfig is not supported by lwarp and is not used in the chapters)
\RequirePackage{tikzorbital}
\RequirePackage{tabularray}\UseTblrLibrary{booktabs}
% tabularray is not supported by lwarp -> what prepare_html.py cannot convert becomes an image
\AtBeginDocument{\preto\tblr{\begin{lateximage}[table]}\appto\endtblr{\end{lateximage}}}
\AtBeginDocument{\preto\longtblr{\begin{lateximage}[table]}\appto\endlongtblr{\end{lateximage}}}
\RequirePackage{booktabs,multirow,array,tabularx,colortbl}   % tabularx: HTML replacement of tblr (prepare_html.py)
\RequirePackage[justification=centering,labelsep=period]{caption}
\RequirePackage[outercaption,wide]{sidecap}
\RequirePackage{subcaption}
\RequirePackage[inline]{enumitem}\setlist{nosep}
\RequirePackage{epigraph}
\setlength\epigraphrule{0pt}
\def\tabcaption{\def\@captype{table}\caption}
\def\figcaption{\def\@captype{figure}\caption}
\RequirePackage{currfile}
\newcommand{\localinput}[1]{\IfFileExists{_html/\currfilebase/tikz/#1}{\input{_html/\currfilebase/tikz/#1}}{\input{\currfilebase/tikz/#1}}}
\def\schapter#1{\chapter*{#1}\addcontentsline{toc}{chapter}{#1}}
\ExplSyntaxOn
\NewDocumentCommand{\multiinclude}{ m O{} }
 {\clist_set:Nx \l_Chapters_clist{ #1 }
  \clist_map_inline:Nn \l_Chapters_clist { \IfFileExists{_html/##1/##1#2.tex}{\input{_html/##1/##1#2.tex}}{\InputIfFileExists{##1/##1#2}{}{}}\par}}
\ExplSyntaxOff
\newcommand{\htmlinput}[1]{\IfFileExists{_html/#1.tex}{\input{_html/#1.tex}}{\InputIfFileExists{#1}{}{\ClassWarning{PySCFBookHTML}{#1.tex not found}}}}
% \input{\currfiledir tikz/X.tikz}: the fixed copy _html/<path> (prepare_html.py) is read first
\newcommand{\htmlinputtikz}[1]{\IfFileExists{_html/#1}{\input{_html/#1}}{\input{#1}}}
% \url in a \caption ("used in a moving argument")
\AtBeginDocument{\DeclareRobustCommand{\url}[1]{\href{#1}{\detokenize{#1}}}}
% print-only helpers that chapters may use
\providecommand{\tcbset}[1]{}
\providecommand{\Needspace}[1]{}
\providecommand{\FloatBarrier}{}
\providecommand{\todo}[2][]{}
\providecommand{\printindex}[1][]{}
\providecommand{\ConspectDir}{}

% ---- TikZ, PGFPlots and all picture styles: taken from PySCFBook.cls
\ConspectShared{tikz}
% libraries that the print build gets from other packages
\usetikzlibrary{positioning,fit,matrix,decorations.pathreplacing}

% ---- bibliography: the biblatex setup of PySCFBook.cls (\ifbiblatex branch)
\RequirePackage[backend=biber,bibstyle=numeric,maxnames=10,autolang=other,isbn=true,url=false,defernumbers=true,sorting=none]{biblatex}
\newbibmacro{string+url}[1]{%
  \iffieldundef{url}{#1}{\begingroup\edef\x{\endgroup\noexpand\href{\thefield{url}}}\x{#1}}}
\DeclareFieldFormat{title}{\usebibmacro{string+url}{#1}}
\DeclareFieldFormat[book,collection,mvbook]{title}{\mkbibbold{#1}}
\DefineBibliographyStrings{ukrainian}{bibliography = {Література}}
\DeclareBibliographyCategory{Textbooks}
\DeclareBibliographyCategory{Main}
\DeclareBibliographyCategory{Additional}
\DeclareBibliographyCategory{Problems}
\DeclareBibliographyCategory{pyscf}
\DeclareFieldFormat{labelnumber}{#1}
\DeclareFieldFormat{labelnumberwidth}{#1.}
\newcommand*{\addtocategoryNoCi}[2]{\addtocategory{#1}{#2}\nocite{#2}}
\newcommand{\schapterpage}[1]{\ForceHTMLPage\schapter{#1}}
\defbibheading{bibintoc}{\schapterpage{Література}}
\defbibheading{subheading}[\bibname]{\section*{#1}}

% ---- appendices: sections A, B, ... on one page "Додатки"
\makeatletter
\let\ConspectOrigAppendix\appendix
\renewcommand\appendix{%
  \ConspectOrigAppendix
  \setcounter{section}{0}%
  \gdef\thesection{\@Alph\c@section}%
  \@addtoreset{table}{section}\@addtoreset{equation}{section}%
  \renewcommand\thetable{\thesection.\@arabic\c@table}%
  \@addtoreset{figure}{section}%
  \renewcommand\thefigure{\thesection.\@arabic\c@figure}%
  \renewcommand\theequation{\thesection.\arabic{equation}}%
  \schapterpage{Додатки}}
\makeatother

%===============================================================================
%  Boxes, code, problems: simple HTML blocks (styled by CSS classes)
%===============================================================================
\newcommand{\nosection}[1]{\section*{#1}\addcontentsline{toc}{section}{#1}}
% commentbox[title]: a remark/tip box (print: tcolorbox)
\NewDocumentEnvironment{commentbox}{O{Коментар}}{\begin{BlockClass}{cb-comment}\textbf{#1}\par}{\end{BlockClass}}
\newenvironment{remark}[1][]{\begin{BlockClass}{cb-comment}\textbf{Зауваження.}\ }{\end{BlockClass}}
\newlist{tasks}{enumerate}{1}
\setlist[tasks]{label=\textbf{Задача \arabic*:}}
\RequirePackage{ntheorem}
\theoremstyle{plain}\theoremheaderfont{\bfseries}\theorembodyfont{\normalfont}\theoremseparator{.}
\newtheorem{problem}{Задача}[chapter]
\newenvironment{wrapstuff}[1][]{\begin{figure}[h]}{\end{figure}}
\NewDocumentEnvironment{wrapfigure}{o m m}{\begin{figure}[h]}{\end{figure}}
\RequirePackage{answers}
\Newassociation{solution}{Solution}{answer}
\renewenvironment{Solution}[1]{\begin{BlockClass}{cb-answer}\textbf{#1.}\ }{\end{BlockClass}}
\newcommand{\answers}{\schapterpage{Відповіді}}
\RequirePackage{fontawesome5}

% ---- code: NOT typeset by lwarp (pdftotext loses indentation and blank lines) ----
% prepare_html.py replaces every minted block by \htmlcode{hash}{lang} and writes the source to _html/code/<hash>.txt;
% publish_html.py replaces the marker with a block highlighted by Pygments (copy button: book.js).
\newcommand{\htmlcode}[2]{\begin{BlockClass}{codeph}CODEBLOCK#1L#2E\end{BlockClass}}
% inline code: print is a tcolorbox, here a <span class="inlinecode">
\newcommand{\inlinecode}[1]{\InlineClass{inlinecode}{\texttt{#1}}}
% \inputcode[mode=inline|link, base=..]{file.py}: print shows the file (inline) or a button with a link to GitHub.
% HTML: inline = a code block (marker CODEFILE[path], filled in by publish_html.py), link = a chip with a link to GitHub.
\def\rootURI{https://github.com/sergiokapone/QChemLectures/blob/master/PyscfBook/}
\makeatletter
\define@key{inputcode}{mode}{\def\icXmode{#1}}
\define@key{inputcode}{prefix}{\def\icXprefix{#1}}
\define@key{inputcode}{base}{\def\icXbase{#1}}
\define@key{inputcode}{mod}{}% typo in two chapters (mod=inline): the print class ignores unknown keys, so does this one
\makeatother
\NewDocumentCommand{\inputcode}{ O{} m }{%
  \begingroup
  \def\icXmode{link}\def\icXprefix{}\def\icXbase{}%
  \setkeys{inputcode}{#1}%
  \edef\icXfile{\detokenize{#2}}%
  \edef\icXpath{\detokenize\expandafter{\ConspectDir}code/\detokenize{#2}}%
  \ifdefempty{\icXbase}{\edef\icXurl{\rootURI\icXpath}}{\edef\icXurl{\icXbase#2}}%
  \ifdefstring{\icXmode}{inline}{%
    \begin{BlockClass}{codeph}CODEFILE[\icXpath]\end{BlockClass}}%
  {\icXprefix\InlineClass{codebutton}{\href{\icXurl}{\texttt{\icXfile}}}}%
  \endgroup}

